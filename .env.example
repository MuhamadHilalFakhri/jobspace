# Pooled PostgreSQL connection string from Neon for application runtime.
# Keep sslmode=require in the URL; the app verifies the server certificate.
DATABASE_URL=

# Direct (unpooled) Neon connection string, used only by npm run db:migrate.
DATABASE_URL_UNPOOLED=

# Secret for session cookie signing. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Where uploaded application documents are stored on disk (dev/local).
UPLOAD_DIR=./storage/documents

# App URL used for absolute links in emails/exports.
NEXT_PUBLIC_APP_URL=http://localhost:3000

